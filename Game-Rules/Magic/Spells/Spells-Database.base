filters:
  and:
    - '!file.inFolder("Publishing/Templates")'
    - file.tags.contains("spell")
formulas:
  Untitled: ""
views:
  - type: table
    name: All Spells
    order:
      - file.name
      - occlusion
      - technique
      - potency
      - paths
    sort:
      - property: occlusion
        direction: ASC
      - property: technique
        direction: ASC
      - property: formula.Untitled
        direction: ASC
      - property: path
        direction: ASC
    columnSize:
      note.technique: 108
  - type: table
    name: Starting Spells
    filters:
      and:
        - potency <= 2
        - occlusion <= 2
        - technique == "Thaumaturgy"
    order:
      - file.name
      - occlusion
      - technique
      - potency
      - paths
    sort:
      - property: technique
        direction: DESC
  - type: table
    name: Adjure Air
    filters:
      and:
        - technique == "Adjuration"
        - paths.contains("Air")
    order:
      - file.name
      - occlusion
      - potency
    sort:
      - property: occlusion
        direction: ASC
  - type: table
    name: Alter Air
    filters:
      and:
        - technique == "Alteration"
        - paths.contains("Air")
    order:
      - file.name
      - occlusion
      - potency
    sort:
      - property: occlusion
        direction: ASC
  - type: table
    name: Conjure Air
    filters:
      and:
        - technique == "Conjuration"
        - paths.contains("Air")
    order:
      - file.name
      - occlusion
      - potency
    sort:
      - property: occlusion
        direction: ASC
  - type: table
    name: Enchant Air
    filters:
      and:
        - technique == "Enchantment"
        - paths.contains("Air")
    order:
      - file.name
      - occlusion
      - potency
    sort:
      - property: occlusion
        direction: ASC
  - type: table
    name: Thaumaturgy Air
